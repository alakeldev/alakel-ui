{
  "name": "alakel-ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@12.0.2",
  "engines": {
    "node": ">=24.15.0 <25"
  },
  "workspaces": [
    "apps/*",
    "packages/*/*"
  ],
  "scripts": {
    "biome:check": "biome check",
    "biome:fix": "biome check --write",
    "docker:build": "docker compose build",
    "docker:start": "docker compose up -d",
    "docker:stop": "docker compose down",
    "docker:rebuild": "npm run docker:stop && npm run docker:build && npm run docker:start",
    "dev": "turbo run dev",
    "dev:docs": "turbo run dev --filter=@alakel/docs",
    "dev:packages": "turbo run dev --filter='./packages/*/*'",
    "tsc:check": "turbo run typecheck",
    "build": "turbo run build",
    "build:packages": "turbo run build --filter='./packages/*/*'",
    "clean": "find . -path './.git' -prune -o -type d \\( -name node_modules -o -name .next -o -name .turbo -o -name .cache -o -name .vite -o -name dist -o -name build -o -name out -o -name coverage \\) -prune -exec rm -rf {} + && find . -path './.git' -prune -o -type f \\( -name '*.tsbuildinfo' -o -name next-env.d.ts \\) -exec rm -f {} +",
    "upgrade:interactive": "npm-check-updates --interactive --workspaces --install never --cooldown 7d --dep prod,dev,optional,peer",
    "prepare": "command -v lefthook > /dev/null 2>&1 && lefthook install || true"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.8",
    "lefthook": "^2.1.10",
    "npm-check-updates": "23.0.2",
    "turbo": "^2.10.10",
    "typescript": "^6.0.3"
  },
  "allowScripts": {
    "lefthook": false
  }
}
