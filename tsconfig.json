{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "allowUnreachableCode": false,
    "noImplicitAny": true,
    "skipLibCheck": true,
    "noImplicitReturns": true,
    "declaration": true,
    "sourceMap": true,
    "jsx": "react-jsx",
    "types": ["jest", "@testing-library/jest-dom"],
    "paths": {
      "@akex/*": ["./packages/*/src"]
    }
  },
  "include": ["packages/**/*", "apps/**/*"]
}
