# Development Dockerfile - Optimized for layer caching
FROM node:24-alpine

# Install system dependencies
RUN apk add --no-cache libc6-compat
RUN npm install --global npm@12.0.2

WORKDIR /app

# Step 1: Copy root package files (changes less frequently)
COPY package.json package-lock.json turbo.json ./

# Step 2: Copy workspaces required by npm during installation
# Copy every package category so new package workspaces are discovered automatically
COPY packages ./packages
COPY apps/web/package.json ./apps/web/
COPY apps/mobile/package.json ./apps/mobile/

# Step 3: Install dependencies - CACHED unless package.json changes
# Uses npm cache mount for faster reinstalls
RUN --mount=type=cache,target=/root/.npm \
    npm ci --ignore-scripts

# Step 4: Copy config files
COPY biome.json tsconfig.json ./

# Step 5: Copy application source code
COPY apps ./apps

# Step 6: Build packages
RUN npm run build:packages

# Expose application port
EXPOSE 3001

# Default command
CMD ["npm", "run", "dev"]
