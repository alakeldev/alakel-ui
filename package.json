{
  "name": "alakel-ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@12.0.2",
  "engines": {
    "node": ">=24.15.0 <25"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "biome:check": "biome check",
    "biome:fix": "biome check --write",
    "docker:build": "docker compose build",
    "docker:start": "docker compose up -d",
    "docker:stop": "docker compose down",
    "docker:rebuild": "npm run docker:stop && npm run docker:build && npm run docker:start",
    "dev": "turbo run dev",
    "dev:web": "turbo run dev --filter=@alakel/web",
    "dev:packages": "turbo run dev --filter='./packages/*'",
    "tsc:check": "turbo run typecheck",
    "build": "turbo run build",
    "build:packages": "turbo run build --filter='./packages/*'",
    "clean": "turbo run clean && rm -rf node_modules",
    "upgrade:interactive": "npm-check-updates --interactive --workspaces --install never --cooldown 7d --dep prod,dev,optional,peer",
    "prepare": "command -v lefthook > /dev/null 2>&1 && lefthook install || true"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.8",
    "lefthook": "^2.1.10",
    "npm-check-updates": "23.0.2",
    "turbo": "^2.10.10",
    "typescript": "^6.0.3"
  },
  "allowScripts": {
    "lefthook": false
  }
}
