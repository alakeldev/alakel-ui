{
  "name": "@alakel-ui/button",
  "version": "0.1.0",
  "private": false,
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --out-dir dist",
    "dev": "tsup src/index.ts --watch --format esm,cjs --dts --out-dir dist",
    "test": "jest --config ../../jest.config.cjs --rootDir=../.. --testMatch='**/packages/button/**/*.test.{ts,tsx}'",
    "test:watch": "jest --config ../../jest.config.cjs --rootDir=../.. --testMatch='**/packages/button/**/*.test.{ts,tsx}' --watch",
    "test:coverage": "jest --config ../../jest.config.cjs --rootDir=../.. --testMatch='**/packages/button/**/*.test.{ts,tsx}' --coverage",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "peerDependencies": {
    "react": "^19.2.3",
    "react-dom": "^19.2.3"
  },
  "dependencies": {
    "@alakel-ui/utils": "*",
    "@base-ui/react": "^1.4.1",
    "class-variance-authority": "^0.7.1"
  },
  "devDependencies": {
    "@types/react": "^19.2.3",
    "@types/react-dom": "^19.2.3",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3"
  }
}
