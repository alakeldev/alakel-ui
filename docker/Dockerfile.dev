# Development Dockerfile
FROM node:22-alpine

# Install dependencies
RUN apk add --no-cache libc6-compat git

# Set working directory
WORKDIR /app

# Copy package files first (for better layer caching)
COPY package.json package-lock.json ./
COPY turbo.json biome.json tsconfig.json ./

# Copy all package.json files
COPY packages/utils/package.json ./packages/utils/
COPY packages/button/package.json ./packages/button/
COPY packages/card/package.json ./packages/card/
COPY packages/label/package.json ./packages/label/
COPY apps/docs/package.json ./apps/docs/
COPY apps/playground/package.json ./apps/playground/

# Install all dependencies (skip prepare scripts since no git in Docker)
RUN npm ci --legacy-peer-deps --ignore-scripts

# Copy ALL source code into container
COPY packages/ ./packages/
COPY apps/ ./apps/

# Build packages first
RUN npm run build:packages

# Expose ports
EXPOSE 3001 3002

# Default command (can be overridden in docker-compose)
CMD ["npm", "run", "dev"]
