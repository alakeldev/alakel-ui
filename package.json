{
  "name": "alakel-ui",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.7.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently \"npm:dev:ui\" \"npm:dev:web\"",
    "dev:ui": "cd packages/ui && npm run dev",
    "dev:web": "cd apps/web && npm run dev",
    "build": "turbo run build",
    "lint": "biome check",
    "format": "biome format --write",
    "typecheck": "turbo run typecheck"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.11",
    "concurrently": "^9.2.1",
    "npm-check-updates": "^19.2.1",
    "prettier": "^3.7.4",
    "sass": "^1.97.1",
    "tsup": "^8.5.1",
    "turbo": "^2.7.2",
    "typescript": "^5.9.3"
  }
}
