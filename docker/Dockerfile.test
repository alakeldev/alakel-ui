# Test Dockerfile - runs the full Jest suite in an isolated container
FROM node:22-alpine

RUN apk add --no-cache libc6-compat

WORKDIR /app

# Copy root workspace manifests
COPY package.json package-lock.json turbo.json biome.json tsconfig.json ./
COPY jest.config.cjs jest.setup.cjs ./

# Copy individual workspace package.json files so npm ci can resolve
# all workspaces before any source code is copied (layer caching).
COPY packages/accordion/package.json ./packages/accordion/
COPY packages/button/package.json ./packages/button/
COPY packages/card/package.json ./packages/card/
COPY packages/carousel/package.json ./packages/carousel/
COPY packages/input/package.json ./packages/input/
COPY packages/label/package.json ./packages/label/
COPY packages/utils/package.json ./packages/utils/
COPY apps/web/package.json ./apps/web/
COPY apps/mobile/package.json ./apps/mobile/

# Install dependencies — --ignore-scripts skips git hooks (lefthook)
RUN npm ci --ignore-scripts

# Copy shared configs, mocks, and all source
COPY packages/tsconfig.base.json ./packages/
COPY __mocks__ ./__mocks__/
COPY packages ./packages
COPY apps ./apps

# Build packages (required before running tests)
RUN npm run build:packages

CMD ["npm", "run", "jest:test"]
