{
  "name": "alakel-ui",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.7.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "biome lint",
    "format": "biome format --write",
    "check": "biome check",
    "typecheck": "turbo run typecheck",
    "update:interactive": "npx npm-check-updates -i"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.11",
    "npm-check-updates": "^19.2.1",
    "prettier": "^3.7.4",
    "sass": "^1.97.1",
    "tsup": "^8.5.1",
    "turbo": "^2.7.2",
    "typescript": "^5.9.3"
  }
}
