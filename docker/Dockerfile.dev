# Development Dockerfile - Optimized for layer caching
FROM node:22-alpine

# Install system dependencies
RUN apk add --no-cache libc6-compat

WORKDIR /app

# Step 1: Copy root package files (changes less frequently)
COPY package.json package-lock.json turbo.json ./

# Step 2: Copy all workspace package.json files
# This layer caches unless dependencies change
COPY packages/button/package.json ./packages/button/
COPY packages/card/package.json ./packages/card/
COPY packages/label/package.json ./packages/label/
COPY packages/utils/package.json ./packages/utils/
COPY apps/akex/package.json ./apps/akex/

# Step 3: Install dependencies - CACHED unless package.json changes
# Uses npm cache mount for faster reinstalls
RUN --mount=type=cache,target=/root/.npm \
    npm ci --legacy-peer-deps --ignore-scripts

# Step 4: Copy config files
COPY biome.json tsconfig.json ./
COPY packages/tsconfig.base.json ./packages/

# Step 5: Copy all source code (changes frequently, but deps are cached)
COPY packages ./packages
COPY apps ./apps

# Step 6: Build packages
RUN npm run build:packages

# Expose application port
EXPOSE 3001

# Default command
CMD ["npm", "run", "dev"]
