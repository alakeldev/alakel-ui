{
	"$schema": "https://biomejs.dev/schemas/latest/schema.json",
	"files": {
		"includes": [
			"**",
			"!**/dist",
			"!**/build",
			"!**/.next",
			"!**/.turbo",
			"!**/node_modules",
			"!**/coverage"
		]
	},
	"linter": {
		"enabled": true,
		"includes": [
			"packages/**/*.{ts,tsx}",
			"apps/**/*.{ts,tsx}",
			"!**/dist/**",
			"!**/build/**",
			"!**/.next/**",
			"!**/.turbo/**",
			"!**/node_modules/**",
			"!**/coverage/**"
		]
	},
	"formatter": {
		"enabled": true,
		"includes": [
			"packages/**/*.{ts,tsx}",
			"apps/**/*.{ts,tsx,js,jsx}",
			"!**/dist/**",
			"!**/build/**",
			"!**/.next/**",
			"!**/.turbo/**",
			"!**/node_modules/**",
			"!**/coverage/**"
		]
	},
	"overrides": [
		{
			"includes": ["apps/mobile/**"],
			"linter": {
				"rules": {
					"suspicious": {
						"noConsole": "off"
					}
				}
			}
		}
	]
}
