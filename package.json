{
  "name": "alakel-ui",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.7.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "docker:build": "docker compose -f docker/docker-compose.yml build",
    "docker:up": "docker compose -f docker/docker-compose.yml up -d",
    "docker:down": "docker compose -f docker/docker-compose.yml down",
    "docker:logs": "docker compose -f docker/docker-compose.yml logs -f",
    "docker:ps": "docker ps",
    "docker:rebuild": "npm run docker:down && npm run docker:build && npm run docker:up",
    "docker:test:build": "docker build -f docker/Dockerfile.test -t alakel-ui-test .",
    "docker:test:run": "docker run --rm alakel-ui-test",
    "docker:test": "npm run docker:test:build && npm run docker:test:run",
    "start": "npm run docker:up && npm run docker:logs",
    "stop": "npm run docker:down",
    "dev": "turbo run dev",
    "dev:docs": "turbo run dev --filter=docs",
    "dev:playground": "turbo run dev --filter=playground",
    "dev:packages": "turbo run dev --filter='./packages/*'",
    "build": "turbo run build",
    "build:packages": "turbo run build --filter='./packages/*'",
    "test": "turbo run test",
    "test:watch": "turbo run test:watch",
    "test:packages": "turbo run test --filter='./packages/*'",
    "test:coverage": "turbo run test:coverage",
    "lint": "biome check",
    "lint:fix": "biome check --write",
    "format": "biome format --write",
    "typecheck": "turbo run typecheck",
    "clean": "turbo run clean && rm -rf node_modules",
    "publish:packages": "npm run build:packages && cd packages && npm publish --workspaces",
    "prepare": "lefthook install"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.11",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.2",
    "concurrently": "^9.2.1",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "lefthook": "^1.10.3",
    "npm-check-updates": "^19.2.1",
    "prettier": "^3.7.4",
    "sass": "^1.97.1",
    "ts-jest": "^29.2.5",
    "tsup": "^8.5.1",
    "turbo": "^2.7.2",
    "typescript": "^5.9.3"
  }
}
