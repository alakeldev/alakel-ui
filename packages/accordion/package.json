{
  "name": "@alakel/accordion",
  "version": "1.0.0",
  "private": false,
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --external @alakel/utils --out-dir dist",
    "dev": "tsup src/index.ts --watch --format esm,cjs --dts --out-dir dist",
    "test": "jest --config ../../jest.config.cjs --rootDir=../.. --testMatch='**/packages/accordion/**/*.test.{ts,tsx}'",
    "test:watch": "jest --config ../../jest.config.cjs --rootDir=../.. --testMatch='**/packages/accordion/**/*.test.{ts,tsx}' --watch",
    "test:coverage": "jest --config ../../jest.config.cjs --rootDir=../.. --testMatch='**/packages/accordion/**/*.test.{ts,tsx}' --coverage",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "peerDependencies": {
    "react": "^19.2.3",
    "react-dom": "^19.2.3"
  },
  "dependencies": {
    "@alakel/utils": "*",
    "motion": "^12.40.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.3",
    "@types/react-dom": "^19.2.3",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3"
  }
}
