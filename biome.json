{
	"$schema": "https://biomejs.dev/schemas/latest/schema.json",
	"files": {
		"includes": [
			"**",
			"!**/dist",
			"!**/build",
			"!**/.next",
			"!**/node_modules",
			"!**/coverage"
		]
	},
	"linter": {
		"enabled": true,
		"includes": [
			"packages/**/*.{ts,tsx}",
			"apps/**/*.{ts,tsx}",
			"!**/dist/**",
			"!**/build/**",
			"!**/.next/**",
			"!**/node_modules/**",
			"!**/coverage/**"
		]
	},
	"formatter": {
		"enabled": true,
		"includes": [
			"packages/**/*.{ts,tsx}",
			"apps/**/*.{ts,tsx,js,jsx}",
			"!**/dist/**",
			"!**/build/**",
			"!**/.next/**",
			"!**/node_modules/**",
			"!**/coverage/**"
		]
	}
}
