{
  "name": "alakel-ui",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.7.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "jest:test": "turbo run test:coverage",
    "jest:update": "turbo run test -- -u",
    "biome:check": "biome check",
    "biome:fix": "biome check --write",
    "stylelint:check": "stylelint \"**/*.{css,scss}\"",
    "stylelint:fix": "stylelint \"**/*.{css,scss}\" --fix",
    "tsc:check": "turbo run typecheck",
    "docker:build": "docker compose -f docker/docker-compose.yml build",
    "docker:start": "docker compose -f docker/docker-compose.yml up -d",
    "docker:stop": "docker compose -f docker/docker-compose.yml down",
    "docker:rebuild": "npm run docker:stop && npm run docker:build && npm run docker:start",
    "dev": "turbo run dev",
    "dev:docs": "turbo run dev --filter=docs",
    "dev:playground": "turbo run dev --filter=playground",
    "dev:packages": "turbo run dev --filter='./packages/*'",
    "build": "turbo run build",
    "build:packages": "turbo run build --filter='./packages/*'",
    "clean": "turbo run clean && rm -rf node_modules",
    "publish:packages": "npm run build:packages && cd packages && npm publish --workspaces",
    "prepare": "lefthook install"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.11",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.2",
    "concurrently": "^9.2.1",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "lefthook": "^1.10.3",
    "npm-check-updates": "^19.2.1",
    "postcss-scss": "^4.0.9",
    "prettier": "^3.7.4",
    "sass": "^1.97.1",
    "stylelint": "^17.9.1",
    "stylelint-config-standard": "^40.0.0",
    "stylelint-config-standard-scss": "^17.0.0",
    "ts-jest": "^29.2.5",
    "tsup": "^8.5.1",
    "turbo": "^2.7.2",
    "typescript": "^5.9.3"
  }
}
