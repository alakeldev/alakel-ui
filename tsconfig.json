{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "allowUnreachableCode": false,
    "noImplicitAny": true,
    "ignoreDeprecations": "6.0",
    "skipLibCheck": true,
    "noImplicitReturns": true,
    "declaration": true,
    "sourceMap": true,
    "jsx": "react-jsx",
    "types": []
  },
  "include": ["packages/**/*", "apps/**/*"]
}
